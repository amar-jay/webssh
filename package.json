{
  "name": "webssh",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @webssh/web dev",
    "dev:state": "pnpm --filter @webssh/state dev",
    "check": "pnpm -r --if-present check",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @webssh/web preview",
    "cli:verify": "cd apps/cli && go mod verify",
    "wasm:build": "pnpm --filter @webssh/transport build:wasm",
    "go:test": "GOMAXPROCS=2 go test -p 1 ./apps/cli/... ./packages/transport/... ./packages/protocol/...",
    "go:vet": "GOMAXPROCS=2 go vet -p 1 ./apps/cli/... ./packages/transport/... ./packages/protocol/...",
    "test:browser": "GOMAXPROCS=2 WEBSSH_BROWSER_TEST=1 go test -p 1 -timeout 150s ./apps/cli/internal/agent -run ^TestBrowserTerminal$ -v"
  }
}
