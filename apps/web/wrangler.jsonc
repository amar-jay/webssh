{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webssh-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSSH_STATE",
        "class_name": "WebSSHState",
        "script_name": "webssh-state"
      }
    ]
  }
}
